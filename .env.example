# Email Account 1 (Primary)
EMAIL_USER_1=your-email@gmail.com
EMAIL_PASSWORD_1=your-gmail-app-password

# Email Account 2 (Secondary - optional)
EMAIL_USER_2=your-other-email@gmail.com
EMAIL_PASSWORD_2=your-other-app-password

# SMTP Settings (defaults to Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# IMAP Settings (for auto-reply)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# Also set as default (can use same as Account 1)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# Auto-reply name
AUTO_REPLY_NAME=Your Name

# Bulk email delay in seconds
BULK_EMAIL_DELAY=2
